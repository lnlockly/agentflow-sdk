{
  "name": "@agentflow/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the AgentFlow API (api.agentflow.website)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agentflow",
    "ai",
    "agents",
    "sdk",
    "typescript",
    "marketplace",
    "launchpad"
  ],
  "homepage": "https://agentflow.website",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentflow/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/agentflow/sdk/issues"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {}
}
